  <snippet name="/moving_marker_pose/pose/pose/orientation/yaw">
   <global></global>
   <function>w = v4
x = v1
y = v2
z = v3

dcm10 = 2 * (x * y + w * z)
dcm00 = w*w + x*x - y*y - z*z

yaw = math.atan2(dcm10, dcm00)

return yaw</function>
